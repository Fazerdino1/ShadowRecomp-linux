// Linux build: the launcher art that the Windows build embeds as resources (runtime/shadow.rc), compiled into the
// binary. Generated by CMake from runtime/platform_resources.cpp.in.
#include "platform.h"

__asm__(".section .rodata\n"
        ".balign 16\n"
        ".global shadow_res_emblem\nshadow_res_emblem:\n.incbin \"@SHADOW_EMBLEM_PNG@\"\n"
        ".global shadow_res_emblem_end\nshadow_res_emblem_end:\n"
        ".balign 16\n"
        ".global shadow_res_hero\nshadow_res_hero:\n.incbin \"@SHADOW_HERO_PNG@\"\n"
        ".global shadow_res_hero_end\nshadow_res_hero_end:\n"
        ".previous\n");
extern "C" const unsigned char shadow_res_emblem[], shadow_res_emblem_end[], shadow_res_hero[], shadow_res_hero_end[];

namespace plat {
const void* resource(int id, size_t* size) {
  const unsigned char *a = nullptr, *b = nullptr;
  if (id == 201) { a = shadow_res_emblem; b = shadow_res_emblem_end; }
  else if (id == 202) { a = shadow_res_hero; b = shadow_res_hero_end; }
  if (!a || a == b) return nullptr;
  if (size) *size = (size_t)(b - a);
  return a;
}
}  // namespace plat
